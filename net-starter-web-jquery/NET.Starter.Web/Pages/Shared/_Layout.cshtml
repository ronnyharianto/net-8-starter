@inject IConfiguration Configuration
@{
    var urlApi = @Configuration["APIUrl"];
    var menu = new[]
    {
        new
        {
            Title = "Dashboard",
            Url = "/",
            Icon = "fas fa-tachometer-alt",
            children = Array.Empty<dynamic>()
        },
        new
        {
            Title = "Organization",
            Url = "#",
            Icon = "fas fa-database",
            children = new dynamic[]
            {
                new
                {
                    Title = "Company",
                    Url = "/organization/company",
                    Icon = "far fa-building",
                    Access = "Organization.Company.Access"
                }
            },
        },
        new
        {
            Title = "Security",
            Url = "#",
            Icon = "fas fa-shield-alt",
            children = new dynamic[]
            {
                new
                {
                    Title = "Role",
                    Url = "/security/role",
                    Icon = "fas fa-suitcase",
                    Access = "Security.Role.Access"
                },
                new
                {
                    Title = "User",
                    Url = "/security/user",
                    Icon = "far fa-id-badge",
                    Access = "Security.User.Access"
                }
            }
        }
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NET.Starter</title>

    <partial name="_Styles" />
</head>
<body class="hold-transition sidebar-mini layout-fixed sidebar-collapse" style="overflow-x: hidden">
    <div id="loader-wrapper" class="d-flex justify-content-center align-items-center">
        <div class="spinner-border text-primary" role="status" style="width: 4rem; height: 4rem;">
            <span class="sr-only">Loading...</span>
        </div>
    </div>

    <!-- Site wrapper -->
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" href="#" role="button" onclick="AccountHelper.refreshMyToken('@urlApi')" title="Full Reload">
                        <i class="fas fa-sync-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button" title="Full screen">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link" data-toggle="dropdown" href="#" title="Change Company">
                        <i class="fas fa-building"></i> <span id="current-company-name">Company A</span>
                    </a>
                    <div id="my-companies" class="dropdown-menu dropdown-menu-right">

                    </div>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->

        <!-- Main Sidebar Container -->
        <aside class="main-sidebar main-sidebar-custom sidebar-light-primary elevation-4">
            <!-- Brand Logo -->
            <a href="/" class="brand-link">
                <img src="~/img/net-starter-logo.png" alt="NET.Starter Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
                <span class="brand-text font-weight-light">NET.Starter</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul id="menu" class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <!-- Add icons to the links using the .nav-icon class
                             with font-awesome or any other icon font library -->
                        @foreach (var item in menu)
                        {
                            <li class="nav-item @(item.children.Length > 0 ? "d-none" : "")">
                                <a href="@item.Url" class="nav-link">
                                    <i class="nav-icon @item.Icon"></i>
                                    <p>
                                        @item.Title
                                        @(item.children.Length > 0 ? Html.Raw("<i class=\"right fas fa-angle-left\"></i>") : "")
                                    </p>
                                </a>
                                @if (item.children.Length > 0)
                                {
                                    <ul class="pl-2 nav nav-treeview">
                                        @foreach (var child in item.children)
                                        {
                                            <li class="nav-item d-none" data-access="@child.Access">
                                                <a href="@child.Url" class="nav-link">
                                                    <i class="nav-icon @child.Icon"></i>
                                                    <p>
                                                        @child.Title
                                                    </p>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->

            <div class="sidebar" style="border-top:1px solid #dee2e6">
                <!-- Sidebar user (optional) -->
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    <div class="image">
                        <img id="userImage" src="" onerror="this.onerror=null;this.src='/img/person-default.png';" class="img-circle elevation-2" alt="User Image">
                        @* <i class="text-xl fa fa-user"></i> *@
                    </div>
                    <div class="info justify-content-between align-items-center w-100" style="display:flex!important">
                        <span id="spanUserName" class="d-block pb-1"></span>
                        <a href="#" class="d-block" onclick="AccountHelper.logoutUser()">
                            <i class="fas fa-sign-out-alt"></i>
                        </a>
                    </div>
                </div>
            </div>
            <!-- /.sidebar-custom -->
        </aside>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            <!-- Content Header (Page header) -->
            <section class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>@ViewData["Header"]</h1>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                @{
                                    var breadcrumb = ViewData["Breadcrumb"] as List<(string Title, string Url)>;
                                    if (breadcrumb != null)
                                    {
                                        foreach (var item in breadcrumb)
                                        {
                                            if (!string.IsNullOrEmpty(item.Url))
                                            {
                                                <li class="breadcrumb-item"><a href="@item.Url">@item.Title</a></li>
                                            }
                                            else
                                            {
                                                <li class="breadcrumb-item active">@item.Title</li>
                                            }
                                        }
                                    }
                                }
                            </ol>
                        </div>
                    </div>
                </div><!-- /.container-fluid -->
            </section>

            <!-- Main content -->
            <section class="content">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </section>
            <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->

        <footer class="main-footer">
            <div class="float-right d-none d-sm-block">
                <b>Version</b> 1.0.0
            </div>
            <strong>Copyright &copy; 2025 <a href="/">NET.Starter</a>.</strong> All rights reserved.
        </footer>
    </div>
    <!-- ./wrapper -->

    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $.fn.dataTable.ext.errMode = 'none';

        const apiBaseUrl = "@urlApi";
        const accessAvailable = AccountHelper.userAccessAvailable();
        const sessionAvailable = AccountHelper.userSessionAvailable();

        if (!sessionAvailable) {
            AccountHelper.logoutUser();
        }

        (async function () {
            if (!accessAvailable) {
                await AccountHelper.refreshMyToken(apiBaseUrl);
            }
        })();

        $(async function () {
            const picture = AccountHelper.userPicture();
            if (picture) {
                $('#userImage').attr('src', picture);
            }
            $('#spanUserName').text(AccountHelper.userName());

            AccountHelper.showMenus();

            if (!localStorage.getItem("myCompanies")) {
                const myCompanies = await DataHelper.loadMyCompanies();
                localStorage.setItem("myCompanies", JSON.stringify(myCompanies));
            }
            
            const myCompanies = JSON.parse(localStorage.getItem("myCompanies"));
            if (myCompanies.length > 0) {
                $('#current-company-name').text(myCompanies.find(d => d.companyId == AccountHelper.userCurrentCompany()).name);

                myCompanies.forEach(c => {
                    $('#my-companies').append(`<a href="#" class="dropdown-item" onclick="AccountHelper.changeCurrentCompany('@urlApi', '${c.companyId}')">${c.name}</a>`);
                });
            }
        });

        // Trigger validate when select2 change value inside a form
        $(document).on('change', '.select2-hidden-accessible', (e) => {
            const el = e.currentTarget;
            const $form = $(el).closest('form');
            if (!$form.length) return;

            const validator = $form.data('validator');
            if (!validator) return;

            validator.element(el);
        });
    </script>
</body>
</html>
