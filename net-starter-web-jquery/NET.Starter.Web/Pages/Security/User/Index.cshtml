@page
@{
    ViewData["Title"] = "User";
    ViewData["Header"] = "Manage User";
    ViewData["Breadcrumb"] = new List<(string, string)>
    {
        ("Dashboard", "/"),
        ("Security", ""),
        ("User", "/security/user")
    };
}

<div class="card">
    <div class="card-body">
        <div id="divFilter">
            <div class="form-group row">
                <div class="col-lg-6">
                    <label>Company</label>
                    <select class="form-control" id="ddlFltCompany" name="flt-companyId"></select>
                </div>
                <div class="col-lg-6">
                    <label>Search</label>
                    <input type="text" class="form-control" id="txtFltSearch" name="flt-searchKey" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-lg-12 text-right">
                    <button type="button" class="btn btn-md btn-secondary" id="btnReset" style="min-width:150px">Reset Filter</button>
                    <button type="button" class="btn btn-mdl btn-success" id="btnFilter" style="min-width:150px">Filter</button>
                </div>
            </div>
        </div>
        
        <hr />

        <div class="row">
            <div class="col-lg-12">
                <table id="gridUser" class="table table-bordered table-hover"></table>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Pages/Security/User/Components/_UserForm.cshtml")
@section scripts {
    @await Html.PartialAsync("~/Pages/Security/User/Scripts/_Index.cshtml")
}